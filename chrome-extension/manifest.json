{
  "manifest_version": 3,
  "name": "Privacy Shield AI",
  "version": "1.2",
  "permissions": [
    "storage", 
    "offscreen", 
    "tabs", 
    "activeTab", 
    "scripting",
    "offscreen",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["js-file/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"]
    }
  ]
}
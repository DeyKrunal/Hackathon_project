{
  "manifest_version": 3,
  "name": "PrivacyShield - Global Monitor",
  "version": "0.1",
  "description": "Monitors tabs and blurs the page if an unauthorized face is detected.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_title": "PrivacyShield",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/**"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
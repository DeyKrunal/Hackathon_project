{
  "manifest_version": 3,
  "name": "Privacy Shield AI",
  "version": "1.0",
  "permissions": ["storage", "tabs", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "js-file/vision_bundle.js",
        "js-file/vision_wasm_internal.js",
        "js-file/vision_wasm_internal.wasm",
        "js-file/vision_wasm_nosimd_internal.js",
        "js-file/face_landmarker.task",
        "mediapipe-loader.js",
        "libs/tf.min.js",
        "libs/blazeface.min.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
